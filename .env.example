NODE_ENV=development
HOST=127.0.0.1
PORT=4331
DB_USERNAME=your_local_postgres_user
DB_PASSWORD=
DB_DATABASE=vibe_development
DB_HOST=127.0.0.1
DB_PORT=5432
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required in production: exact public HTTPS origin. No paths, wildcard, or trailing slash.
VIBE_PUBLIC_ORIGIN=https://vibe.example.com
# Optional only on an explicitly configured Vercel preview deployment.
# VIBE_PREVIEW_ORIGIN=https://vibe-git-branch-team.vercel.app

# Optional exact HTTPS portfolio parent. No paths, wildcard, or trailing slash.
# VIBE_PORTFOLIO_ORIGIN=https://your-machine.your-tailnet.ts.net:8447
