include ui

doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover')
    meta(name='description' content='Vibe: discover electronic, chill and game-inspired music, and make it your own playlist.')
    link(rel='icon' href='/public/images/favicon.ico')
    link(rel='stylesheet' href='/public/stylesheets/base.css')
    link(rel='stylesheet' href=`/public/stylesheets/${page}.css`)
    if page === 'music'
      link(rel='stylesheet' href='/public/stylesheets/catalog.css')
      link(rel='stylesheet' href='/public/stylesheets/library.css')
    link(rel='stylesheet' href='/public/stylesheets/motion.css')
    script(type='module' src='/public/js/motion.js')
    if script
      script(type='module' src=`/public/js/${script}.js`)
    title= title
  body(class=`page-${page}`)
    a.skip-link(href='#mainContent') Skip to content
    block content
